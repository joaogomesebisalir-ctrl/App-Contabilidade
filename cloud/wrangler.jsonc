{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conta-clara",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/download/*", "/health"],
  },
  "vars": { "APP_DB_SCHEMA": "conta_clara", "SUPABASE_BUCKET": "conta-clara" },
}
