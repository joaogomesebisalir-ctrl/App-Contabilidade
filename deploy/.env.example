# Values must be entered privately in the hosting provider, not committed or sent in chat.
APP_STORAGE_BACKEND=supabase
SUPABASE_BUCKET=conta-clara
APP_HTTPS=1
APP_REQUIRE_EXTERNAL_STORAGE=1
# Session-mode PostgreSQL pooler URL from the project's Connect panel, port 5432.
DATABASE_URL=
SUPABASE_URL=
# Server-only service_role JWT or secret API key; never the anon/publishable key.
SUPABASE_STORAGE_KEY=
# Render Blueprint generates these two values privately.
APP_SECRET_KEY=
APP_SETUP_TOKEN=
